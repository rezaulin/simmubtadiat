# Salin menjadi `.env` lalu isi nilainya.
#   cp .env.example .env
#
# Pada instalasi via `deploy.sh`, berkas .env DIBUAT OTOMATIS dengan
# rahasia acak (chmod 600) — Anda tidak perlu mengisi file ini secara manual.
# File ini HANYA referensi nama variabel (tanpa rahasia).

# ── Database ────────────────────────────────────────────────────────────────
# Dipakai docker-compose; host container app adalah `db` (jaringan internal).
DB_USER=mubtadiaat
DB_PASS=ganti-dengan-password-acak-minimal-24-karakter
DB_NAME=mubtadiaat_db

# Hanya untuk menjalankan aplikasi langsung di luar Docker (go run .)
DB_HOST=localhost
DB_PORT=5432

# ── Keamanan ────────────────────────────────────────────────────────────────
# WAJIB diisi — compose menolak start tanpa nilai ini.
JWT_SECRET=ganti-dengan-string-acak-minimal-40-karakter

# ── Seed admin (dipakai migrate-runner saat start pertama) ──────────────────
SEED_ADMIN_USERNAME=admin
# Kosongkan => deploy.sh akan generate password acak dan menampilkannya
# di layar saat deploy selesai.
SEED_ADMIN_PASSWORD=
